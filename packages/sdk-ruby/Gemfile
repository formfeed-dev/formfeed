# frozen_string_literal: true

# The tools that check the SDK. The gem itself needs nothing but Ruby's standard library, so the
# gemspec names no dependency and this file no gemspec: scripts/ruby.mjs installs it per Ruby version
# outside the repository, with its lockfile there.
