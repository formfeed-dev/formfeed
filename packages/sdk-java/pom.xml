<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Java SDK of Formfeed (plan 34). Java 11 and newer; java.net.http and Jackson databind 2.x are
  all it needs at run time. `scripts/java.mjs` runs its checks in Docker:

    node packages/sdk-java/scripts/java.mjs test         JUnit on Java 11 (JAVA=25 for the newest LTS)
    node packages/sdk-java/scripts/java.mjs lint         -Xlint:all -Werror, javadoc and google-java-format
    node packages/sdk-java/scripts/java.mjs fix          formats the sources

  The `release` profile signs and publishes to Maven Central; nothing else activates it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.formfeed</groupId>
  <artifactId>formfeed</artifactId>
  <version>0.3.30</version>
  <packaging>jar</packaging>

  <name>Formfeed</name>
  <description>Java client for the Formfeed API: PDFs and images from templates, HTML, URLs or Markdown, and tools for existing PDFs.</description>
  <url>https://formfeed.dev</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>formfeed</id>
      <name>Formfeed</name>
      <email>support@formfeed.dev</email>
      <organization>Formfeed</organization>
      <organizationUrl>https://formfeed.dev</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/formfeed-dev/formfeed.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/formfeed-dev/formfeed.git</developerConnection>
    <url>https://github.com/formfeed-dev/formfeed</url>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/formfeed-dev/formfeed/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <!-- scripts/java.mjs builds outside the mounted checkout, so a container leaves nothing behind -->
    <formfeed.build>${project.basedir}/target</formfeed.build>

    <jackson.version>2.23.0</jackson.version>
    <junit.version>5.14.4</junit.version>
    <spotless.version>3.12.0</spotless.version>
    <google-java-format.version>2.0.0</google-java-format.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <directory>${formfeed.build}</directory>

    <resources>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
        </includes>
      </resource>
    </resources>

    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- the tests read the shared vectors, the goldens and the release version beside the package -->
          <systemPropertyVariables>
            <formfeed.package>${project.basedir}</formfeed.package>
          </systemPropertyVariables>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
            <manifestEntries>
              <Automatic-Module-Name>dev.formfeed</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <doclint>all,-missing</doclint>
          <quiet>true</quiet>
          <failOnWarnings>true</failOnWarnings>
          <windowtitle>Formfeed Java SDK ${project.version}</windowtitle>
          <doctitle>Formfeed Java SDK ${project.version}</doctitle>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- What `java.mjs lint` adds: every javac warning is an error, in the sources and the tests. -->
    <profile>
      <id>lint</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <showWarnings>true</showWarnings>
              <failOnWarning>true</failOnWarning>
              <compilerArgs>
                <arg>-Xlint:all</arg>
                <arg>-Werror</arg>
              </compilerArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- google-java-format needs Java 21 to run, so the formatter exists from that JDK on. -->
    <profile>
      <id>format</id>
      <activation>
        <jdk>[21,)</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.diffplug.spotless</groupId>
            <artifactId>spotless-maven-plugin</artifactId>
            <version>${spotless.version}</version>
            <configuration>
              <!-- the repository keeps LF (.gitattributes), and a container cannot read the worktree's git -->
              <lineEndings>UNIX</lineEndings>
              <java>
                <includes>
                  <include>src/**/*.java</include>
                </includes>
                <googleJavaFormat>
                  <version>${google-java-format.version}</version>
                  <style>GOOGLE</style>
                </googleJavaFormat>
              </java>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Maven Central (the public repository's release workflow): signs every file with the key in
      MAVEN_GPG_KEY (passphrase MAVEN_GPG_PASSPHRASE) and uploads the bundle with the Portal token
      of the server `central` in settings.xml.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <signer>bc</signer>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
