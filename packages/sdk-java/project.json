{
  "name": "sdk-java",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/sdk-java/src/main/java",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/pom.xml",
        "{projectRoot}/README.md",
        "{projectRoot}/operations.json",
        "{projectRoot}/docker/Dockerfile",
        "{workspaceRoot}/packages/api-types/fixtures/**/*",
        "{workspaceRoot}/tools/publish/packages.mjs",
        "{projectRoot}/scripts/java.mjs",
        { "env": "JAVA" }
      ],
      "options": {
        "command": "node packages/sdk-java/scripts/java.mjs test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/pom.xml",
        "{projectRoot}/docker/Dockerfile",
        "{projectRoot}/scripts/java.mjs"
      ],
      "options": {
        "command": "node packages/sdk-java/scripts/java.mjs lint"
      }
    },
    "fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node packages/sdk-java/scripts/java.mjs fix"
      }
    }
  }
}
