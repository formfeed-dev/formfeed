"<div class="ff-design">
  <div class="ff-layer l-title" data-ff-layer="title" data-ff-fit="shrink" data-ff-fit-min="36"><p class="ff-text">Invoice {{ invoice.number }}<br>for {{ customer.name | upper }}</p></div>
