exports[`emitDesign > jinja2: writes the fixture as it always did > html 1`] = `
"<div class="ff-design">
  <div class="ff-layer l-title" data-ff-layer="title" data-ff-fit="shrink" data-ff-fit-min="36"><p class="ff-text">Invoice {{ invoice.number }}<br>for {{ customer.name | upper }}</p></div>
  {% if invoice.total %}<div class="ff-layer l-total" data-ff-layer="total"><p class="ff-text">{{ invoice.total | money }} due {{ invoice.due | date('d MMMM yyyy') }}</p></div>{% endif %}
  <img class="ff-layer l-logo" data-ff-layer="logo" src="{{ brand.logo.primary }}" alt="">
  <img class="ff-layer l-photo" data-ff-layer="photo" src="{{ asset('team\\'s photo.png') }}" alt="">
  <div class="ff-layer l-badge" data-ff-layer="badge"></div>
  <img class="ff-layer l-qr" data-ff-layer="qr" src="{{ qrcode(invoice.url, { ecc: 'M', margin: 0, color: '#111111', background: '#ffffff00' }) }}" alt="">
  <img class="ff-layer l-ean" data-ff-layer="ean" src="{{ barcode('4006381333931', { type: 'ean13', text: true }) }}" alt="">
</div>
"
`;

