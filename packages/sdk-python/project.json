{
  "name": "sdk-python",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/sdk-python/src",
  "tags": ["scope:sdk"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tests/**/*", "{projectRoot}/pyproject.toml"],
      "options": { "command": "python -m pytest -q", "cwd": "packages/sdk-python" }
    },
    "check": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*"],
      "options": { "command": "python -m compileall -q src", "cwd": "packages/sdk-python" }
    },
    "package": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "python -m build --wheel --sdist", "cwd": "packages/sdk-python" }
    }
  }
}
