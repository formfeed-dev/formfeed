{
  "name": "sdk-go",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/sdk-go",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/operations.json",
        "{workspaceRoot}/packages/api-types/fixtures/**/*",
        "{workspaceRoot}/tools/publish/packages.mjs",
        "{projectRoot}/scripts/go.mjs",
        "{projectRoot}/docker/Dockerfile",
        { "env": "GO" }
      ],
      "options": {
        "command": "node packages/sdk-go/scripts/go.mjs test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/scripts/go.mjs",
        "{projectRoot}/docker/Dockerfile",
        { "env": "GO" }
      ],
      "options": {
        "command": "node packages/sdk-go/scripts/go.mjs lint"
      }
    },
    "fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node packages/sdk-go/scripts/go.mjs fix"
      }
    }
  }
}
