<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0 tests the library's net10.0 build; net8.0 takes its netstandard2.0 build, so both are
       exercised. The Docker image carries both runtimes (docker/Dockerfile). -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Formfeed.Tests</RootNamespace>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- for IDE0005 (unused usings) in the build; the tests document nothing -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Formfeed/Formfeed.csproj" />
  </ItemGroup>

  <!-- Where the package folder is, so the tests read operations.json, the shared vectors and the
       goldens of packages/api-types wherever the build output lands. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FormfeedPackageRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
